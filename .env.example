# SentinelFlow — environment variables (PLACEHOLDERS ONLY, never commit real values)

# ASI:One model API (OpenAI-compatible). Used only for intent parsing / phrasing.
ASI1_BASE_URL=https://api.asi1.ai/v1
ASI1_API_KEY=sk-YOUR_ASI1_KEY_HERE
ASI1_MODEL=asi1

# uAgents mailbox (Agentverse) — used at Step 8 (Agentverse registration)
# Create a mailbox at https://agentverse.ai and paste its address here.
AGENTVERSE_MAILBOX_KEY=
# Optional: fixed seed for deterministic agent identity (leave empty to generate)
AGENT_SEED=

# Agent network settings
AGENT_PORT=8081
